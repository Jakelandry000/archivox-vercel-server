generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RunStatus {
  QUEUED
  COMPLETE
  ERROR
}

model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs Run[]

  @@index([createdAt])
}

model Run {
  id        String    @id @default(cuid())
  projectId String
  prompt    String
  status    RunStatus @default(COMPLETE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Future: blob URLs + any derived metadata
  // layoutJsonUrl String?
  // svgUrl        String?
  // scrUrl        String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}
