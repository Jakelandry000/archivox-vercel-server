  "type": "module",
  "main": "src/index.ts",
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "prisma": "^7.5.0",
    "vitest": "^4.1.5"
  },
  "scripts": {
