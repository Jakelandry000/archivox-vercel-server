# ArchiVox — root .env.example
# Copy to .env and fill in your values. Never commit .env.
#
# ── Neon / Vercel Postgres ────────────────────────────────────────────────────
#
# DATABASE_URL  – POOLED connection string (used by Prisma Client at runtime).
#                 Hostname contains "-pooler".
#
# DIRECT_URL    – DIRECT (non-pooled) connection string (used by Prisma Migrate
#                 and Prisma Studio to bypass the pooler).
#                 Hostname does NOT contain "-pooler".
#
# Both URLs are shown in the Neon console under Connection Details.
# In local dev you may set both to the same direct URL.
#
# !! Windows / PowerShell warning !!
# The & in query params will be interpreted as a background operator in shells.
# Always edit .env with a text editor (notepad .env) — never paste into a terminal.
#
# ── Vercel ───────────────────────────────────────────────────────────────────
# Add both vars in the Vercel dashboard under Settings > Environment Variables.
# Paste the raw URL without surrounding quotes — Vercel handles escaping.

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DATABASE?channel_binding=require&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DATABASE?sslmode=require"
