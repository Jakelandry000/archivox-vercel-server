{
  "name": "archivox",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @archivox/web",
    "build": "npm run prisma:generate --workspace @archivox/db && npm run build --workspace @archivox/web",
    "lint": "npm run lint --workspaces",
    "test": "npx tsx packages/core/src/validator.test.ts && npx tsx packages/core/src/rulebookV1Checks.test.ts",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:motion": "npx playwright test e2e/motion-test",
    "test:e2e:visual": "npx playwright test e2e/landing-page-visual e2e/motion-test-visual",
    "test:e2e:visual:update": "npx playwright test e2e/landing-page-visual e2e/motion-test-visual --update-snapshots",
    "db:generate": "npm run prisma:generate --workspace @archivox/db",
    "db:migrate": "npm run prisma:migrate:dev --workspace @archivox/db",
    "db:studio": "npm run prisma:studio --workspace @archivox/db"
  },
  "dependencies": {
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
