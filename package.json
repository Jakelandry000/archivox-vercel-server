{
  "name": "archivox",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @archivox/web",
    "build": "npm run build --workspace @archivox/web",
    "lint": "npm run lint --workspace @archivox/web",
    "test": "echo \"(no tests yet)\"",
    "prisma:generate": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "postinstall": "npm run prisma:generate"
  },
  "devDependencies": {
    "prisma": "^6.16.1"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "@types/three": "^0.183.1",
    "pg": "^8.20.0",
    "three": "^0.183.2"
  }
}
